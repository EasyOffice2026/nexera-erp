// Database schema. Tables and columns use snake_case; models use PascalCase.
// Names that people read are bilingual JSON: { "en": "...", "ar": "..." }.
// Every row belongs to one tenant (a subscribing customer); queries always filter by tenant_id.
// Amounts are NUMERIC(18,3): Kuwaiti dinars with fils.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  finance_manager
  accountant
  auditor

  @@map("role")
}

enum Language {
  en
  ar

  @@map("language")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE

  @@map("account_type")
}

enum PeriodStatus {
  OPEN
  CLOSED

  @@map("period_status")
}

enum JournalStatus {
  DRAFT
  POSTED

  @@map("journal_status")
}

enum JournalSource {
  MANUAL
  OPENING
  REVERSAL
  INTEGRATION
  BANK

  @@map("journal_source")
}

model Tenant {
  id        String   @id @default(uuid(7)) @db.Uuid
  // Typed on the sign-in screen, for example "easyoffice".
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  users     User[]
  companies Company[]

  @@map("tenants")
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String
  fullName     String    @map("full_name")
  passwordHash String    @map("password_hash")
  role         Role
  language     Language  @default(en)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // Only the SHA-256 of the token is kept.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// One legal entity (Commercial Registration). Each company files its own statements on Qayd.
model Company {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  name               Json
  legalName          String   @map("legal_name")
  crNumber           String   @map("cr_number")
  baseCurrency       String   @default("KWD") @map("base_currency")
  fiscalYearEndMonth Int      @default(12) @map("fiscal_year_end_month")
  // The number of the last posted journal. Incrementing it locks the row, so posting is serial.
  journalSeq         Int      @default(0) @map("journal_seq")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  brands       Brand[]
  branches     Branch[]
  accounts     Account[]
  fiscalYears  FiscalYear[]
  periods      Period[]
  journals     JournalEntry[]
  bankAccounts BankAccount[]

  @@unique([tenantId, crNumber])
  @@index([tenantId])
  @@map("companies")
}

model Brand {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      Json
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId], references: [id])
  branches Branch[]

  @@index([companyId])
  @@map("brands")
}

// A branch is also the cost centre that journal lines are analysed by.
model Branch {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  brandId   String   @map("brand_id") @db.Uuid
  code      String
  name      Json
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company       @relation(fields: [companyId], references: [id])
  brand   Brand         @relation(fields: [brandId], references: [id])
  lines   JournalLine[]

  @@unique([companyId, code])
  @@map("branches")
}

model Account {
  id              String      @id @default(uuid(7)) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  companyId       String      @map("company_id") @db.Uuid
  code            String
  name            Json
  type            AccountType
  // Where the account appears in the statements (see packages/shared/src/accounts.ts).
  subtype         String
  parentId        String?     @map("parent_id") @db.Uuid
  isPostable      Boolean     @default(true) @map("is_postable")
  isActive        Boolean     @default(true) @map("is_active")
  // The IFRS / Qayd taxonomy element used for XBRL, for example "ifrs-full:Inventories".
  taxonomyConcept String?     @map("taxonomy_concept")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company       @relation(fields: [companyId], references: [id])
  parent   Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children Account[]     @relation("AccountTree")
  lines    JournalLine[]
  bank     BankAccount?

  @@unique([companyId, code])
  @@map("accounts")
}

model FiscalYear {
  id        String       @id @default(uuid(7)) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  name      String
  startDate DateTime     @map("start_date") @db.Date
  endDate   DateTime     @map("end_date") @db.Date
  status    PeriodStatus @default(OPEN)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company  @relation(fields: [companyId], references: [id])
  periods Period[]

  @@unique([companyId, startDate])
  @@map("fiscal_years")
}

model Period {
  id           String       @id @default(uuid(7)) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  companyId    String       @map("company_id") @db.Uuid
  fiscalYearId String       @map("fiscal_year_id") @db.Uuid
  number       Int
  startDate    DateTime     @map("start_date") @db.Date
  endDate      DateTime     @map("end_date") @db.Date
  status       PeriodStatus @default(OPEN)
  closedAt     DateTime?    @map("closed_at") @db.Timestamptz(3)
  closedById   String?      @map("closed_by_id") @db.Uuid

  company    Company        @relation(fields: [companyId], references: [id])
  fiscalYear FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  journals   JournalEntry[]

  @@unique([companyId, startDate])
  @@map("periods")
}

// Posted entries are never changed or deleted. A mistake is corrected by a reversal.
model JournalEntry {
  id           String        @id @default(uuid(7)) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  companyId    String        @map("company_id") @db.Uuid
  periodId     String        @map("period_id") @db.Uuid
  // Given when the entry is posted, in order, per company.
  number       Int?
  date         DateTime      @db.Date
  description  String
  reference    String        @default("")
  source       JournalSource @default(MANUAL)
  // The system and its own id for entries that arrive through the integration API.
  sourceSystem String?       @map("source_system")
  externalId   String?       @map("external_id")
  status       JournalStatus @default(DRAFT)
  totalDebit   Decimal       @default(0) @map("total_debit") @db.Decimal(18, 3)
  totalCredit  Decimal       @default(0) @map("total_credit") @db.Decimal(18, 3)
  reversesId   String?       @unique @map("reverses_id") @db.Uuid
  createdById  String?       @map("created_by_id") @db.Uuid
  postedById   String?       @map("posted_by_id") @db.Uuid
  postedAt     DateTime?     @map("posted_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  company    Company       @relation(fields: [companyId], references: [id])
  period     Period        @relation(fields: [periodId], references: [id])
  reverses   JournalEntry? @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy JournalEntry? @relation("Reversal")
  lines      JournalLine[]

  @@unique([companyId, number])
  @@unique([companyId, sourceSystem, externalId])
  @@index([companyId, date])
  @@map("journal_entries")
}

model JournalLine {
  id          String  @id @default(uuid(7)) @db.Uuid
  entryId     String  @map("entry_id") @db.Uuid
  lineNo      Int     @map("line_no")
  accountId   String  @map("account_id") @db.Uuid
  branchId    String? @map("branch_id") @db.Uuid
  description String  @default("")
  debit       Decimal @default(0) @db.Decimal(18, 3)
  credit      Decimal @default(0) @db.Decimal(18, 3)

  entry    JournalEntry       @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account  Account            @relation(fields: [accountId], references: [id])
  branch   Branch?            @relation(fields: [branchId], references: [id])
  bankLine BankStatementLine?

  @@unique([entryId, lineNo])
  @@index([accountId])
  @@map("journal_lines")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  data       Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

enum BankDirection {
  ANY
  IN
  OUT

  @@map("bank_direction")
}

// A bank account at a bank, linked to its account in the chart. Statement amounts are signed:
// positive is money into the bank.
model BankAccount {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  accountId       String    @unique @map("account_id") @db.Uuid
  bankName        String    @map("bank_name")
  accountNumber   String    @default("") @map("account_number")
  currency        String    @default("KWD")
  // The balance at the bank before the first imported statement line.
  openingBalance  Decimal   @default(0) @map("opening_balance") @db.Decimal(18, 3)
  // The column mapping of this bank's statement file, remembered from the last import.
  mapping         Json?
  // Statement lines and bank-account postings up to this date are reconciled and locked.
  reconciledUntil DateTime? @map("reconciled_until") @db.Date
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company         Company              @relation(fields: [companyId], references: [id])
  account         Account              @relation(fields: [accountId], references: [id])
  statements      BankStatement[]
  lines           BankStatementLine[]
  rules           BankRule[]
  reconciliations BankReconciliation[]

  @@index([companyId])
  @@map("bank_accounts")
}

model BankStatement {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  bankAccountId String   @map("bank_account_id") @db.Uuid
  fileName      String   @map("file_name")
  fromDate      DateTime @map("from_date") @db.Date
  toDate        DateTime @map("to_date") @db.Date
  lineCount     Int      @map("line_count")
  importedById  String?  @map("imported_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  bankAccount BankAccount         @relation(fields: [bankAccountId], references: [id])
  lines       BankStatementLine[]

  @@index([bankAccountId])
  @@map("bank_statements")
}

model BankStatementLine {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  bankAccountId String    @map("bank_account_id") @db.Uuid
  statementId   String    @map("statement_id") @db.Uuid
  // The place of the line within its statement, oldest first.
  lineNo        Int       @map("line_no")
  date          DateTime  @db.Date
  description   String
  reference     String    @default("")
  amount        Decimal   @db.Decimal(18, 3)
  balance       Decimal?  @db.Decimal(18, 3)
  // Date, amount, texts and the occurrence number, so importing the same file twice adds nothing.
  fingerprint   String
  journalLineId String?   @unique @map("journal_line_id") @db.Uuid
  ruleId        String?   @map("rule_id") @db.Uuid
  matchedById   String?   @map("matched_by_id") @db.Uuid
  matchedAt     DateTime? @map("matched_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  bankAccount BankAccount   @relation(fields: [bankAccountId], references: [id])
  statement   BankStatement @relation(fields: [statementId], references: [id])
  journalLine JournalLine?  @relation(fields: [journalLineId], references: [id])
  rule        BankRule?     @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([bankAccountId, fingerprint])
  @@index([bankAccountId, date])
  @@map("bank_statement_lines")
}

// "Description contains KNET -> KNET receivable": a journal is created for matching lines.
model BankRule {
  id            String        @id @default(uuid(7)) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  bankAccountId String?       @map("bank_account_id") @db.Uuid
  name          String
  contains      String
  direction     BankDirection @default(ANY)
  accountId     String        @map("account_id") @db.Uuid
  branchId      String?       @map("branch_id") @db.Uuid
  priority      Int           @default(100)
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  bankAccount BankAccount?        @relation(fields: [bankAccountId], references: [id])
  lines       BankStatementLine[]

  @@index([companyId])
  @@map("bank_rules")
}

model BankReconciliation {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  bankAccountId    String   @map("bank_account_id") @db.Uuid
  asOf             DateTime @map("as_of") @db.Date
  statementBalance Decimal  @map("statement_balance") @db.Decimal(18, 3)
  bookBalance      Decimal  @map("book_balance") @db.Decimal(18, 3)
  createdById      String?  @map("created_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@unique([bankAccountId, asOf])
  @@map("bank_reconciliations")
}
