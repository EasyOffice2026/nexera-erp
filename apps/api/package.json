{
  "name": "@nexera/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx --env-file-if-exists=../../.env src/server.ts",
    "build": "node ../../scripts/bundle-node.mjs src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "tenant:create": "tsx --env-file-if-exists=../../.env prisma/create-tenant.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cookie": "^2.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nexera/shared": "*",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
