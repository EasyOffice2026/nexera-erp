# Copy this file to .env for local development. .env is never committed.
# Every value below is optional in development: the defaults are the ones shown.
# In production the API refuses to start without its own DATABASE_URL and JWT_ACCESS_SECRET.

# Docker Compose database (docker-compose.yml).
POSTGRES_USER=nexera
POSTGRES_PASSWORD=nexera
POSTGRES_DB=nexera
POSTGRES_PORT=5432

# The web dev server forwards /api to this port (apps/web/vite.config.ts).
API_PORT=3000

# Database for the API, migrations and tests. Tests use their own schema (nexera_test).
DATABASE_URL=postgresql://nexera:nexera@localhost:5432/nexera

# Secret that signs access tokens (at least 32 characters). In production use a long random value:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-token-secret-do-not-use-in-production

# How many reverse proxies sit in front of the API (0 for none).
TRUST_PROXY=0
